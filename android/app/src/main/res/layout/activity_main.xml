<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FF1B1410">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFE8D9A8"
            android:textSize="32sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFBFB59A"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_sync_notice"
            android:visibility="gone" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_start"
            android:text="@string/btn_start_game" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_import"
            android:text="@string/btn_import_game" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_import_zip"
            android:text="@string/btn_import_zip" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_files"
            android:enabled="false"
            android:text="@string/btn_manage_files" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_saves"
            android:text="@string/btn_saves" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_manual"
            android:text="@string/btn_manual" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_settings"
            android:text="@string/btn_settings" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_info"
            android:text="@string/btn_info" />

        <Button
            style="@style/LauncherButton"
            android:id="@+id/btn_exit"
            android:text="@string/btn_exit" />
    </LinearLayout>
</ScrollView>
