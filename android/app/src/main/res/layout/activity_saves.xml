<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1B1410"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/saves_title" />

        <TextView
            android:id="@+id/saves_info"
            style="@style/SettingsLabel" />

        <ProgressBar
            android:id="@+id/saves_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_saves_list"
            style="@style/LauncherButton"
            android:layout_marginTop="16dp"
            android:text="@string/savelist_open" />

        <Button
            android:id="@+id/btn_saves_export"
            style="@style/LauncherButton"
            android:text="@string/saves_export" />

        <Button
            android:id="@+id/btn_saves_import"
            style="@style/LauncherButton"
            android:text="@string/saves_import" />

        <Button
            android:id="@+id/btn_saves_restore"
            style="@style/LauncherButton"
            android:text="@string/saves_restore" />

        <Button
            android:id="@+id/btn_saves_delete"
            style="@style/LauncherButton"
            android:text="@string/saves_delete" />

        <TextView
            style="@style/SettingsHint"
            android:layout_marginTop="16dp"
            android:text="@string/saves_hint" />

        <TextView
            style="@style/SettingsSection"
            android:text="@string/sync_title" />

        <TextView
            android:id="@+id/sync_info"
            style="@style/SettingsLabel" />

        <Button
            android:id="@+id/btn_sync_run"
            style="@style/LauncherButton"
            android:layout_marginTop="8dp"
            android:text="@string/sync_run" />

        <Button
            android:id="@+id/btn_sync_choose"
            style="@style/LauncherButton"
            android:text="@string/sync_choose" />

        <Switch
            android:id="@+id/switch_sync_auto"
            style="@style/SettingsSwitch"
            android:text="@string/sync_auto" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/sync_auto_hint" />

        <Switch
            android:id="@+id/switch_sync_auto_down"
            style="@style/SettingsSwitch"
            android:text="@string/sync_auto_down" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/sync_auto_down_hint" />

        <TextView
            style="@style/SettingsHint"
            android:text="@string/sync_hint" />

        <Button
            android:id="@+id/btn_saves_close"
            style="@style/LauncherButton"
            android:layout_marginTop="16dp"
            android:text="@string/btn_close" />
    </LinearLayout>
</ScrollView>
